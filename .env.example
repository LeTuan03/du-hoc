# Sao chép thành .env.local và điều chỉnh giá trị

# URL công khai của site (dùng cho SEO metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tài khoản đăng nhập Admin CMS
ADMIN_EMAIL=admin@duhoc.edu.vn
ADMIN_PASSWORD=Admin@123456

# Secret ký cookie phiên admin (đổi thành chuỗi ngẫu nhiên dài khi deploy)
AUTH_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://postgres.tlgoaqstecfepriswqhi:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Storage (upload ảnh) — service role key lấy ở Dashboard > Settings > API Keys
# Bỏ trống SUPABASE_URL/KEY khi dev local → ảnh lưu vào public/uploads như cũ
SUPABASE_URL=https://tlgoaqstecfepkaoiwqhi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
